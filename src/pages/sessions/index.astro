---
import Layout from '../../layouts/Layout.astro';
import { laneConfigFromSession } from '../../lib/lanes';
import { fetchMiniScoresheets, fetchEarliestIncompleteFrame, fetchEarliestIncompleteWarmupFrame, type MiniSheet } from '../../lib/scoring';
import { buildSessionHandicapResolver } from '../../lib/handicap';
import { fetchAllGamesWithScores } from '../../lib/stats';

const { supabase } = Astro.locals;

const params = Astro.url.searchParams;
const filterType = params.get('type') ?? '';
const filterAlley = params.get('alley') ?? '';
const filterFrom = params.get('from') ?? '';
const filterTo = params.get('to') ?? '';
const hasFilters = Boolean(filterType || filterAlley || filterFrom || filterTo);

let sessionsQuery = supabase
  .from('sessions')
  .select('*, leagues(name), games(id, final_score, ended_early, is_warmup, created_at, game_number)')
  .order('session_date', { ascending: false })
  .order('created_at', { ascending: false })
  .order('created_at', { foreignTable: 'games', ascending: true });

if (filterType === 'league' || filterType === 'practice') {
  sessionsQuery = sessionsQuery.eq('session_type', filterType);
}
if (filterAlley) {
  // Partial/case-insensitive match, not an exact .eq() -- the alley field is
  // free-text now (a datalist suggests known names but doesn't enforce an
  // exact pick), so a typo or partial name should still narrow the list
  // instead of silently returning zero results.
  sessionsQuery = sessionsQuery.ilike('alley_name', `%${filterAlley}%`);
}
if (filterFrom) {
  sessionsQuery = sessionsQuery.gte('session_date', filterFrom);
}
if (filterTo) {
  sessionsQuery = sessionsQuery.lte('session_date', filterTo);
}

const { data: sessions } = await sessionsQuery;

const { data: alleyRows } = await supabase.from('sessions').select('alley_name').not('alley_name', 'is', null);
const alleyOptions = Array.from(new Set((alleyRows ?? []).map((r) => r.alley_name))).sort();

// ---- Resume link per session (in-progress game) -----------------------------
// A game is done once it has a manual final score or is explicitly marked ended
// (covers a warmup's "End Practice", which never gets a final_score); only
// unfinished games need a mini-scoresheet to tell "in progress" from "not
// started yet" (dashboard rule).
type GameRow = {
  id: string;
  final_score: number | null;
  ended_early: boolean;
  is_warmup: boolean;
  created_at: string;
  game_number: number | null;
};
const unfinishedGameIds = (sessions ?? []).flatMap((s) =>
  (s.games as GameRow[]).filter((g) => g.final_score == null && !g.ended_early).map((g) => g.id),
);
const sheets = await fetchMiniScoresheets(supabase, unfinishedGameIds);

function gameComplete(game: GameRow) {
  if (game.final_score != null || game.ended_early) return true;
  const sheet = sheets.get(game.id);
  return sheet != null && sheet.cells[9].cumulative != null;
}

const resumeBySession = new Map<string, string>(); // session id -> in-progress game id
for (const s of sessions ?? []) {
  const game = (s.games as GameRow[]).find((g) => !gameComplete(g));
  if (game) resumeBySession.set(s.id, game.id);
}
const resumeFrames = new Map<string, number>(); // game id -> earliest incomplete frame
for (const [sessionId, gameId] of resumeBySession) {
  const session = (sessions ?? []).find((s) => s.id === sessionId);
  const game = (session?.games as GameRow[] | undefined)?.find((g) => g.id === gameId);
  resumeFrames.set(
    gameId,
    game?.is_warmup
      ? await fetchEarliestIncompleteWarmupFrame(supabase, gameId)
      : await fetchEarliestIncompleteFrame(supabase, gameId),
  );
}

// ---- Table view: per-game scratch scores + series scratch/handicap --------
// A scored game's number is final_score, falling back to the derived total
// from its mini-scoresheet's last frame (unfinishedGameIds already covers
// every game with no final_score, warmup included, so this needs no extra
// fetch). The warmup/practice slot never counts toward Game N columns or the
// series -- same rule fetchBestSeriesStats uses for all-time bests.
function scratchScore(game: GameRow): number | null {
  if (game.final_score != null) return game.final_score;
  return sheets.get(game.id)?.cells[9]?.cumulative ?? null;
}

// Batched handicap resolver (one query for every league's config + one for
// every game ever, reused across all sessions here) instead of a per-session
// lookup -- resolves to null for practice sessions, so those naturally show
// scratch only.
const allGamesEver = await fetchAllGamesWithScores(supabase);
const handicapOf = await buildSessionHandicapResolver(supabase, allGamesEver);

type SessionRow = {
  session: NonNullable<typeof sessions>[number];
  scoredGames: GameRow[];
  scores: (number | null)[];
  seriesScratch: number | null;
  sessionHandicap: number | null;
};

const sessionRows: SessionRow[] = (sessions ?? []).map((session) => {
  const scoredGames = (session.games as GameRow[])
    .filter((g) => !g.is_warmup)
    .sort((a, b) => (a.game_number ?? Infinity) - (b.game_number ?? Infinity) || a.created_at.localeCompare(b.created_at));
  const scores = scoredGames.map(scratchScore);
  const playedScores = scores.filter((s): s is number => s != null);
  const seriesScratch = playedScores.length > 0 ? playedScores.reduce((a, b) => a + b, 0) : null;
  const sessionHandicap = handicapOf(session);

  return { session, scoredGames, scores, seriesScratch, sessionHandicap };
});

// Capped at 3 so a long practice session's game count can't blow up the
// table's width -- games beyond the cap still count toward the series total,
// just not their own column (see the "+N" badge on the last shown column).
const MAX_GAME_COLUMNS = 3;
const maxGames = Math.min(MAX_GAME_COLUMNS, sessionRows.reduce((max, r) => Math.max(max, r.scoredGames.length), 0));

// Percentage widths (table-layout: fixed) instead of letting the browser size
// columns to unwrapped content -- that's what was forcing the table wider
// than the (480px-max, mobile-first) page and requiring a horizontal scroll.
// Date/Session/Lane/Series/Handicap get a fixed share; whatever's left is
// split evenly across however many Game columns are actually shown.
const DATE_COL_PCT = 12;
const SESS_COL_PCT = 26;
const LANE_COL_PCT = 11;
const SERIES_COL_PCT = 13;
const HDCP_COL_PCT = 10;
const gamesPoolPct = 100 - (DATE_COL_PCT + SESS_COL_PCT + LANE_COL_PCT + SERIES_COL_PCT + HDCP_COL_PCT);
const gameColPct = maxGames > 0 ? gamesPoolPct / maxGames : 0;

// "Jul 12" (year only when it isn't the current one) -- same T00:00:00 parse
// the game page uses so a plain date column doesn't shift a day from UTC
// parsing. Made prominent in its own line now that "League"/"Practice" text
// is gone from the row, replaced by the colored side stripe.
const thisYear = new Date().getFullYear();
function formatSessionDate(iso: string): string {
  const d = new Date(`${iso}T00:00:00`);
  const opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' };
  if (d.getFullYear() !== thisYear) opts.year = 'numeric';
  return d.toLocaleDateString('en-US', opts);
}
---

<Layout title="Sessions">
  <nav class="top"><a href="/dashboard">&larr; Dashboard</a></nav>
  <div class="page-head">
    <h1>Sessions</h1>
    <a class="button" href="/sessions/new">+ Start a Session</a>
  </div>

  <details class="filter-collapse" open={hasFilters}>
  <summary>
    Filters
    {hasFilters && <span class="filter-badge">Active</span>}
  </summary>
  <form method="GET" class="filter-form">
    <label>
      Type
      <select name="type">
        <option value="" selected={!filterType}>All</option>
        <option value="league" selected={filterType === 'league'}>League</option>
        <option value="practice" selected={filterType === 'practice'}>Practice</option>
      </select>
    </label>
    <label>
      Alley
      <input type="text" name="alley" list="alley-options" value={filterAlley} placeholder="Type to search…" autocomplete="off" />
      <datalist id="alley-options">
        {alleyOptions.map((alley) => <option value={alley} />)}
      </datalist>
    </label>
    <label>
      From
      <input type="date" name="from" value={filterFrom} />
    </label>
    <label>
      To
      <input type="date" name="to" value={filterTo} />
    </label>
    <button type="submit">Filter</button>
    {hasFilters && <a href="/sessions">Clear Filters</a>}
  </form>
  </details>

  {sessionRows.length > 0 ? (
    <>
    <div class="table-legend">
      <span class="legend-item"><i class="legend-swatch is-league"></i>League</span>
      <span class="legend-item"><i class="legend-swatch is-practice"></i>Practice</span>
    </div>
    <div class="table-scroll">
      <table class="sessions-table">
        <thead>
          <tr>
            <th class="date-col" style={`width: ${DATE_COL_PCT}%`}>DATE</th>
            <th class="sess-col" style={`width: ${SESS_COL_PCT}%`}>SESSION</th>
            <th class="num-col" style={`width: ${LANE_COL_PCT}%`}>LN</th>
            {Array.from({ length: maxGames }, (_, i) => (
              <th class="num-col" style={`width: ${gameColPct}%`}>GM {i + 1}</th>
            ))}
            <th class="num-col" style={`width: ${SERIES_COL_PCT}%`}>SERIES</th>
            <th class="num-col" style={`width: ${HDCP_COL_PCT}%`}>HDCP</th>
          </tr>
        </thead>
        <tbody>
          {sessionRows.map(({ session, scoredGames, scores, seriesScratch, sessionHandicap }) => {
            const resumeGameId = resumeBySession.get(session.id);
            const extraGames = Math.max(0, scoredGames.length - maxGames);
            const isLeague = session.session_type === 'league';
            const leagueName = session.leagues?.name ?? null;
            const laneConfig = laneConfigFromSession(session);
            // League name leads for a league session (the thing you actually
            // care about at a glance); a standalone practice session has no
            // league name, so the alley fills in as the headline instead.
            // The type word itself ("League"/"Practice") is dropped -- the
            // side stripe on the Date cell carries it.
            const headline = isLeague && leagueName ? leagueName : session.alley_name || 'Unnamed alley';
            return (
              <tr>
                <td class:list={['date-col', isLeague ? 'is-league' : 'is-practice']}>
                  {formatSessionDate(session.session_date)}
                </td>
                <td class="sess-col">
                  <a class="sess-link" href={`/sessions/${session.id}`}>{headline}</a>
                  {resumeGameId && (
                    <a class="card-resume" href={`/sessions/${session.id}/games/${resumeGameId}`}>
                      Resume · Frame {resumeFrames.get(resumeGameId)} &rarr;
                    </a>
                  )}
                </td>
                <td class="num-col">
                  {laneConfig.laneNumber == null ? (
                    '—'
                  ) : laneConfig.secondLaneNumber != null ? (
                    <div class="lane-stack">
                      <span>{laneConfig.laneNumber}</span>
                      <span>{laneConfig.secondLaneNumber}</span>
                    </div>
                  ) : (
                    laneConfig.laneNumber
                  )}
                </td>
                {Array.from({ length: maxGames }, (_, i) => (
                  <td class="num-col">
                    {scoredGames[i] ? (scores[i] ?? '—') : ''}
                    {i === maxGames - 1 && extraGames > 0 && (
                      <a class="more-games" href={`/sessions/${session.id}`} title={`${extraGames} more game${extraGames === 1 ? '' : 's'} — view details`}>
                        +{extraGames}
                      </a>
                    )}
                  </td>
                ))}
                <td class="num-col">{seriesScratch ?? '—'}</td>
                <td class="num-col">{sessionHandicap != null ? `+${sessionHandicap}` : '—'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    </>
  ) : (
    <p class="empty">{hasFilters ? 'No sessions match those filters.' : 'No sessions yet.'} <a href="/sessions/new">Start a session</a>.</p>
  )}
</Layout>

<style>
  .table-legend {
    display: flex;
    gap: var(--s4);
    margin-top: var(--s4);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--s1);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .legend-swatch {
    display: inline-block;
    width: 3px;
    height: 0.9em;
    border-radius: 1px;
  }
  .legend-swatch.is-league {
    background: var(--accent);
  }
  .legend-swatch.is-practice {
    background: var(--mustard);
  }
  .table-scroll {
    margin-top: var(--s2);
    overflow-x: auto;
  }
  .sessions-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }
  .sessions-table th,
  .sessions-table td {
    padding: var(--s2) var(--s1);
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
    overflow-wrap: break-word;
  }
  .sessions-table th {
    text-align: left;
    color: var(--text-muted);
    font-weight: var(--fw-med);
    font-size: var(--text-xs);
  }
  /* Colored side stripe on the leading (Date) cell replaces the old inline
     "League"/"Practice" word -- same info, no extra text needed. Ties to
     .end-action's mustard (already this app's "practice" color) and the
     accent blue used for handicap/league emphasis elsewhere. */
  .date-col.is-league {
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .date-col.is-practice {
    box-shadow: inset 3px 0 0 var(--mustard);
  }
  .date-col {
    padding-left: calc(var(--s1) + 4px);
    font-size: var(--text-sm);
    font-weight: var(--fw-med);
    color: var(--text-secondary);
  }
  .sess-link {
    display: block;
    font-size: var(--text-base);
    font-weight: var(--fw-semi);
    color: var(--text-primary);
    text-decoration: none;
  }
  .sess-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .num-col {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  /* A two-lane pair stacks as two smaller rows instead of "13/12" -- reads
     as two lane numbers rather than a fraction, and matches the compact
     feel of the Series/Hdcp columns' single-value cells. */
  .lane-stack {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    font-size: var(--text-xs);
  }
  /* small "+N" badge on the last shown Game column when a session (almost
     always a long practice session) has more games than fit in the capped
     column count -- links straight to the session's full game list */
  .more-games {
    display: inline-block;
    margin-left: 4px;
    padding: 1px 5px;
    font-size: var(--text-xs);
    font-weight: var(--fw-semi);
    color: var(--accent-ink);
    background: var(--accent);
    border-radius: 999px;
    text-decoration: none;
    vertical-align: middle;
  }
  .sess-col .card-resume {
    text-align: left;
  }
</style>
